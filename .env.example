# Copy to .env and fill in. Every variable read by config/settings.py is listed here.

# Logging
LOG_LEVEL=INFO

# Storage: "local" (default, no credentials) or "gcs" / "r2" (milestone 5)
STORAGE_BACKEND=local
# Root directory for the local lake (bronze/ lives under it)
LAKE_ROOT=./lake
# Bucket name, used only when STORAGE_BACKEND is not local
BUCKET_NAME=

# DA price monitoring
DA_PRICE_MONITORING_URL=https://www.da.gov.ph/price-monitoring/
HTTP_USER_AGENT=PalengkePriceTracker/0.1 (non-commercial portfolio project)
REQUEST_DELAY_SECONDS=5

# PSA OpenSTAT
PSA_API_BASE=https://openstat.psa.gov.ph/PXWeb/api/v1/en/DB

# BigQuery (milestone 8)
GCP_PROJECT_ID=
BQ_DATASET=palengke_gold
GOOGLE_APPLICATION_CREDENTIALS=
